generator client {
  provider = "prisma-client-js"
  output   = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String    @id @default(cuid())
  fullName        String    @db.VarChar(150)
  phoneNumber     String?   @unique @db.VarChar(20)
  email           String?   @unique @db.VarChar(150)
  passwordHash    String    @db.VarChar(255)
  role            Role      @default(FARMER)
  region          String?   @db.VarChar(100)
  nationalIdImageUrl        String?   @db.VarChar(500)
  farmRegistrationImageUrl  String?   @db.VarChar(500)
  businessCertificateImageUrl String? @db.VarChar(500)
  kycStatus       KYCStatus   @default(PENDING)
  kycRejectReason String?
  kycSubmittedAt  DateTime?
  kycApprovedAt   DateTime?
  kycEmailLastSentAt DateTime?
  kycEmailLastStatus KYCStatus?
  kycEmailLastAction String?   @db.VarChar(20)
  kycEmailLastError  String?
  profilePhotoUrl String?   @db.VarChar(300)
  isVerified      Boolean   @default(false)
  isActive        Boolean   @default(true)
  verificationToken       String?   @unique
  verificationTokenExpiry DateTime?
  createdAt       DateTime  @default(now())

  // Relations
  farms             Farm[]
  listings          Listing[]
  buyerOrders       Order[]    @relation("BuyerOrders")
  agentOrders       Order[]    @relation("AgentOrders")
  sentMessages      Message[]  @relation("SentMessages")
  receivedMessages  Message[]  @relation("ReceivedMessages")
  conversationsAsA  Conversation[] @relation("ConversationA")
  conversationsAsB  Conversation[] @relation("ConversationB")
  negotiationOffers NegotiationOffer[] @relation("NegotiationProposer")
  reviewsGiven      Review[]   @relation("ReviewsGiven")
  reviewsReceived   Review[]   @relation("ReviewsReceived")
  disputesFiled     Dispute[]  @relation("DisputeFiledBy")
  disputesAssigned  Dispute[]  @relation("DisputeAssignedTo")
  disputeAuditLogs  DisputeAuditLog[]
  notifications     Notification[]
  agentProfile      FieldAgent?
  productionRecords ProductionRecord[]
  barterRequests    BarterRequest[]
  payments          Payment[]
  agentId           String?
  managedBy         FieldAgent? @relation("ManagedFarmers", fields: [agentId], references: [id])
  agentRequests     AgentRequest[] @relation("FarmerAgentRequests")
  cart              Cart?
}

enum Role {
  FARMER
  BUYER
  AGENT
  ADMIN
}

enum KYCStatus {
  PENDING
  APPROVED
  REJECTED
}

model Farm {
  id               String    @id @default(cuid())
  farmName         String    @db.VarChar(150)
  location         String    @db.VarChar(200)
  sizeInAcres      Decimal?  @db.Decimal(10, 2)
  primaryCropTypes String?
  soilType         String?   @db.VarChar(100)
  waterSource      String?   @db.VarChar(100)
  createdAt        DateTime  @default(now())

  // Foreign keys
  userId            String
  user              User       @relation(fields: [userId], references: [id])
  listings          Listing[]
  productionRecords ProductionRecord[]
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique @db.VarChar(100)
  description String?
  iconUrl     String?    @db.VarChar(300)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  // Self relation
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")

  // Relations
  listings  Listing[]
}

enum ListingType {
  SELL
  BARTER
  BOTH
}

enum ListingStatus {
  ACTIVE
  SOLD
  EXPIRED
  PAUSED
}

enum Unit {
  KG
  BAG
  CRATE
  PIECE
  LITRE
  BUNDLE
}

model Listing {
  id                String        @id @default(cuid())
  title             String        @db.VarChar(200)
  description       String?
  minimumOrderQty   Decimal?      @db.Decimal(10, 2)
  negotiable        Boolean       @default(false)
  quantityAvailable Decimal       @db.Decimal(10, 2)
  quantity          Decimal       @db.Decimal(10, 2)
  unit              Unit
  pricePerUnit      Decimal       @db.Decimal(12, 2)
  listingType       ListingType   @default(SELL)
  status            ListingStatus @default(ACTIVE)
  harvestDate       DateTime?
  location          String        @db.VarChar(200)
  viewsCount        Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Foreign keys
  sellerId   String
  farmId     String?
  categoryId String

  // Relations
  seller    User          @relation(fields: [sellerId], references: [id])
  farm      Farm?         @relation(fields: [farmId], references: [id])
  category  Category      @relation(fields: [categoryId], references: [id])
  images    ListingImage[]
  barterRequestsAsTarget BarterRequest[] @relation("TargetListing")
  barterRequestsAsOffer  BarterRequest[] @relation("OfferedListing")
  messages          Message[]
  conversations     Conversation[]
  negotiationOffers NegotiationOffer[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
}

model ListingImage {
  id         String   @id @default(cuid())
  imageUrl   String   @db.VarChar(500)
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  uploadedAt DateTime @default(now())

  // Foreign key
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Foreign key
  userId String @unique

  // Relations
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  quantity  Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  cartId    String
  listingId String

  // Relations
  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([cartId, listingId])
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  PAY_ONLINE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  DELIVERED
  CANCELLED
}

model Order {
  id                   String        @id @default(cuid())
  totalPrice           Decimal       @db.Decimal(12, 2)
  paymentMethod        PaymentMethod
  status               OrderStatus   @default(PENDING)
  deliveredAt          DateTime?
  deliveryAddress      String?       @db.VarChar(300)
  expectedDeliveryDate DateTime?
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // Foreign keys
  buyerId String
  agentId String?

  // Relations
  buyer   User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  agent   User?       @relation("AgentOrders", fields: [agentId], references: [id], onDelete: SetNull)
  items   OrderItem[]
  payment Payment?
  review  Review?
  dispute Dispute?
}

model OrderItem {
  id               String  @id @default(cuid())
  quantityOrdered  Decimal @db.Decimal(10, 2)
  unitPriceAtOrder Decimal @db.Decimal(12, 2)
  totalPrice       Decimal @db.Decimal(12, 2)

  // Foreign keys
  orderId   String
  listingId String

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id])
}

enum BarterStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model BarterRequest {
  id                 String       @id @default(cuid())
  offeredDescription String?
  offeredQuantity    Decimal?     @db.Decimal(10, 2)
  status             BarterStatus @default(PENDING)
  message            String?
  agreedAt           DateTime?
  createdAt          DateTime     @default(now())

  // Foreign keys
  requesterId      String
  targetListingId  String
  offeredListingId String?

  // Relations
  requester      User     @relation(fields: [requesterId], references: [id])
  targetListing  Listing  @relation("TargetListing", fields: [targetListingId], references: [id])
  offeredListing Listing? @relation("OfferedListing", fields: [offeredListingId], references: [id])
  images         BarterImage[]
}

model BarterImage {
  id        String   @id @default(cuid())
  imageUrl  String   @db.VarChar(500)
  createdAt DateTime @default(now())

  // Foreign key
  barterRequestId String

  // Relations
  barterRequest BarterRequest @relation(fields: [barterRequestId], references: [id], onDelete: Cascade)
}

model FieldAgent {
  id                 String   @id @default(cuid())
  assignedRegion     String   @db.VarChar(100)
  commissionRate     Decimal  @db.Decimal(5, 2)
  totalOrdersHandled Int      @default(0)
  isActive           Boolean  @default(true)
  joinedAt           DateTime @default(now())
  bio                String?
  ratingAvg          Decimal  @default(0) @db.Decimal(3, 2)

  // Foreign key
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  managedFarmers User[]         @relation("ManagedFarmers")
  agentRequests  AgentRequest[]
}

model AgentRequest {
  id        String             @id @default(cuid())
  status    AgentRequestStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  // Foreign keys
  farmerId String
  agentId  String

  // Relations
  farmer User       @relation("FarmerAgentRequests", fields: [farmerId], references: [id], onDelete: Cascade)
  agent  FieldAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([farmerId, agentId])
}

enum AgentRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ProductionUnit {
  KG
  BAG
  CRATE
  PIECE
  LITRE
}

model ProductionRecord {
  id                String         @id @default(cuid())
  cropName          String         @db.VarChar(150)
  plantingDate      DateTime?
  harvestDate       DateTime?
  quantityHarvested Decimal?       @db.Decimal(10, 2)
  unit              ProductionUnit?
  notes             String?
  season            String?        @db.VarChar(50)
  createdAt         DateTime       @default(now())

  // Foreign keys
  farmId       String
  recordedById String

  // Relations
  farm       Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  recordedBy User @relation(fields: [recordedById], references: [id])
}

enum MessageType {
  TEXT
  OFFER
  SYSTEM
}

model Conversation {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastMessageAt DateTime?

  // The two participants (always stored as participantAId < participantBId by cuid sort to enforce uniqueness)
  participantAId String
  participantBId String

  // Optional listing context
  listingId String?

  // Relations
  participantA      User               @relation("ConversationA", fields: [participantAId], references: [id])
  participantB      User               @relation("ConversationB", fields: [participantBId], references: [id])
  listing           Listing?           @relation(fields: [listingId], references: [id], onDelete: SetNull)
  messages          Message[]
  negotiationOffers NegotiationOffer[]

  @@unique([participantAId, participantBId, listingId])
}

model Message {
  id        String      @id @default(cuid())
  content   String
  isRead    Boolean     @default(false)
  sentAt    DateTime    @default(now())
  type      MessageType @default(TEXT)

  // Foreign keys
  senderId        String
  receiverId      String
  listingId       String?
  conversationId  String?

  // Relations
  sender       User          @relation("SentMessages", fields: [senderId], references: [id])
  receiver     User          @relation("ReceivedMessages", fields: [receiverId], references: [id])
  listing      Listing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  attachments  MessageAttachment[]
}

model MessageAttachment {
  id        String   @id @default(cuid())
  imageUrl  String   @db.VarChar(500)
  createdAt DateTime @default(now())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

enum NegotiationStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  WITHDRAWN
}

model NegotiationOffer {
  id             String            @id @default(cuid())
  offeredPrice   Decimal           @db.Decimal(12, 2)
  quantity       Decimal?          @db.Decimal(10, 2)
  note           String?
  status         NegotiationStatus @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Foreign keys
  proposerId     String
  listingId      String
  conversationId String?

  // Relations
  proposer     User          @relation("NegotiationProposer", fields: [proposerId], references: [id])
  listing      Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
}

enum ReviewType {
  BUYER
  SELLER
  AGENT
}

model Review {
  id        String     @id @default(cuid())
  rating    Int
  comment   String?
  type      ReviewType
  createdAt DateTime   @default(now())

  // Foreign keys
  reviewerId     String
  reviewedUserId String
  orderId        String @unique

  // Relations
  reviewer     User  @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewedUser User  @relation("ReviewsReceived", fields: [reviewedUserId], references: [id])
  order        Order @relation(fields: [orderId], references: [id])
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model Dispute {
  id             String        @id @default(cuid())
  reason         String        @db.VarChar(200)
  details        String?
  evidenceUrls   Json?
  status         DisputeStatus @default(OPEN)
  mediationNote  String?
  resolutionNote String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  resolvedAt     DateTime?

  // Foreign keys
  orderId       String @unique
  filedById     String
  assignedToId  String?

  // Relations
  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  filedBy    User  @relation("DisputeFiledBy", fields: [filedById], references: [id])
  assignedTo User? @relation("DisputeAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  auditLogs  DisputeAuditLog[]
}

model DisputeAuditLog {
  id        String   @id @default(cuid())
  action    String   @db.VarChar(100)
  note      String?
  createdAt DateTime @default(now())

  disputeId String
  adminId   String

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  admin   User    @relation(fields: [adminId], references: [id])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

model Payment {
  id                String        @id @default(cuid())
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("GHS") @db.VarChar(10)
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  transactionRef    String?       @db.VarChar(100)
  paidAt            DateTime?
  notes             String?
  paystackReference String?       @unique @db.VarChar(100)
  paystackResponse  Json?
  ipAddress         String?       @db.VarChar(45)
  attemptCount      Int           @default(0)
  createdAt         DateTime      @default(now())

  // Foreign keys
  orderId String @unique
  payerId String

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payer User  @relation(fields: [payerId], references: [id])
}

enum NotificationType {
  ORDER
  BARTER
  MESSAGE
  NEGOTIATION
  REVIEW
  DISPUTE
  SYSTEM
}

model Notification {
  id          String           @id @default(cuid())
  title       String           @db.VarChar(150)
  message     String
  type        NotificationType
  isRead      Boolean          @default(false)
  referenceId String?
  createdAt   DateTime         @default(now())

  // Foreign key
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
